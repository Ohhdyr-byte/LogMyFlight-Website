---
const fields = [
  { id: 'day', label: 'Day', value: '01:25' },
  { id: 'night', label: 'Night', value: '00:00' },
  { id: 'instrument', label: 'Instrument Time', value: '00:00' },
  { id: 'ifr', label: 'IFR Actual', value: '00:00' },
];
---
<section class="custom-demo" data-custom-demo aria-labelledby="custom-demo-title">
  <div class="demo-copy">
    <p class="eyebrow">Your logbook, configured by you</p>
    <h2 id="custom-demo-title">Show what matters.<br />Hide what doesn’t.</h2>
    <p class="lede">Choose which built-in fields fit the way you fly today. Try the switches to simplify the entry form, bring fields back when your training changes, or create your own when you need something different.</p>
    <p class="demo-status" data-demo-status aria-live="polite">All optional fields are shown in the flight entry.</p>
  </div>

  <div class="demo-stage" role="group" aria-label="Interactive product demonstration">
    <div class="app-panel settings-panel">
      <div class="panel-heading">
        <div><small>Logbook settings</small><h3>Flight<br />Properties</h3></div>
        <span class="add" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M12 6v12M6 12h12" /></svg>
        </span>
      </div>
      <p class="group-label">Time</p>
      <div class="field-group">
        <div class="field-row required"><span><strong>Off Block</strong><small>Required for time tracking</small></span><span class="required-dot" aria-hidden="true"></span></div>
        <div class="field-row required"><span><strong>On Block</strong><small>Required for time tracking</small></span><span class="required-dot" aria-hidden="true"></span></div>
        {fields.map((field) => (
          <div class="field-row">
            <span><strong>{field.label}</strong><small>Built-in field</small></span>
            <button class="switch" type="button" role="switch" aria-checked="true" aria-label={`Show ${field.label} in flight entries`} data-field-toggle={field.id}><span></span></button>
          </div>
        ))}
      </div>
      <div class="custom-field"><span class="custom-plus" aria-hidden="true">+</span><span><strong>Create a custom field</strong><small>For example, NM Travelled</small></span></div>
    </div>

    <div class="flow-arrow" aria-hidden="true">→</div>

    <div class="app-panel entry-panel">
      <div class="panel-heading"><div><small>New entry</small><h3>Flight</h3></div><span class="done">Done</span></div>
      <p class="group-label">Flight times</p>
      <div class="field-group preview-fields">
        <div class="preview-row"><span>Off Block</span><strong>09:10</strong></div>
        <div class="preview-row"><span>On Block</span><strong>10:35</strong></div>
        {fields.map((field) => <div class="preview-row" data-preview-field={field.id}><span>{field.label}</span><strong>{field.value}</strong></div>)}
      </div>
    </div>
  </div>
  <noscript><p class="noscript-note">The interactive switches require JavaScript. All fields are shown in this preview.</p></noscript>
</section>

<script>
  const demo = document.querySelector<HTMLElement>('[data-custom-demo]');
  if (demo) {
    const status = demo.querySelector<HTMLElement>('[data-demo-status]');
    const toggles = [...demo.querySelectorAll<HTMLButtonElement>('[data-field-toggle]')];

    toggles.forEach((toggle) => toggle.addEventListener('click', () => {
      const id = toggle.dataset.fieldToggle;
      const row = id ? demo.querySelector<HTMLElement>(`[data-preview-field="${id}"]`) : null;
      if (!id || !row) return;

      const willShow = toggle.getAttribute('aria-checked') !== 'true';
      const fieldName = row.querySelector('span')?.textContent?.trim() ?? 'Field';
      toggle.setAttribute('aria-checked', String(willShow));

      if (willShow) {
        row.hidden = false;
        requestAnimationFrame(() => row.removeAttribute('data-collapsed'));
      } else {
        row.setAttribute('data-collapsed', '');
        const finish = () => { if (row.hasAttribute('data-collapsed')) row.hidden = true; };
        row.addEventListener('transitionend', finish, { once: true });
        window.setTimeout(finish, 450);
      }

      if (status) status.textContent = `${fieldName} ${willShow ? 'shown in' : 'hidden from'} flight entries.`;
    }));
  }
</script>

<style>
  .custom-demo{align-items:center;display:grid;gap:clamp(2.5rem,5vw,5rem);grid-template-columns:minmax(270px,.68fr) minmax(0,1.32fr);margin:0 auto 120px;max-width:var(--max);padding:clamp(2rem,4vw,4rem);position:relative;width:min(calc(100% - 40px),var(--max));z-index:2}.demo-copy h2{font-size:clamp(2.4rem,4.6vw,4.4rem);margin:.7rem 0 1.25rem}.demo-status{color:var(--muted);font-size:.82rem;margin-top:1.25rem;min-height:2.5em}.demo-stage{align-items:center;display:grid;gap:clamp(.65rem,1.5vw,1rem);grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);width:100%}.app-panel{aspect-ratio:9/19.5;background:var(--demo-bg,#0b0b0c);border:1px solid var(--line);border-radius:clamp(25px,3vw,36px);box-shadow:var(--shadow);color:var(--demo-text,#f5f5f7);display:flex;flex-direction:column;min-width:0;overflow:hidden;padding:clamp(.85rem,1.6vw,1.35rem);width:100%}.panel-heading{align-items:center;display:flex;justify-content:space-between;margin-bottom:clamp(.9rem,1.6vw,1.4rem)}.panel-heading small{color:var(--demo-muted,#8e8e93);font-size:clamp(.58rem,1vw,.72rem)}.panel-heading h3{font-size:clamp(1.25rem,2.3vw,1.75rem);line-height:1.02;margin-top:.15rem}.add{align-items:center;background:#0aafd1;border-radius:50%;color:white;display:grid;flex:0 0 auto;height:clamp(38px,4.5vw,48px);place-items:center;width:clamp(38px,4.5vw,48px)}.add svg{display:block;height:55%;width:55%}.add path{fill:none;stroke:currentColor;stroke-linecap:round;stroke-width:2.25}.done{color:#0aafd1;font-size:clamp(.75rem,1.25vw,1rem);font-weight:650}.group-label{color:var(--demo-muted,#8e8e93);font-size:clamp(.62rem,1vw,.78rem);font-weight:700;margin:0 0 .45rem .7rem}.field-group{background:var(--demo-card,#1c1c1e);border-radius:clamp(16px,2.2vw,22px);overflow:hidden}.field-row,.preview-row{align-items:center;border-bottom:1px solid var(--demo-line,#38383a);display:flex;justify-content:space-between;min-height:clamp(46px,5.4vw,60px);padding:clamp(.42rem,.9vw,.68rem) clamp(.65rem,1.2vw,1rem)}.field-row:last-child,.preview-row:last-child{border-bottom:0}.field-row>span:first-child{display:flex;flex-direction:column;min-width:0}.field-row strong{font-size:clamp(.72rem,1.35vw,.98rem)}.field-row small{color:var(--demo-muted,#8e8e93);font-size:clamp(.48rem,.82vw,.63rem)}.required-dot{background:var(--demo-muted,#8e8e93);border-radius:50%;height:6px;width:6px}.switch{background:#30d158;border:0;border-radius:999px;cursor:pointer;flex:0 0 auto;height:clamp(25px,2.8vw,29px);padding:3px;transition:background .25s ease;width:clamp(43px,4.8vw,49px)}.switch span{background:white;border-radius:50%;display:block;height:calc(100% - 0px);margin-left:auto;transition:transform .25s ease;width:calc(clamp(25px,2.8vw,29px) - 6px)}.switch[aria-checked="false"]{background:var(--demo-switch-off,#636366)}.switch[aria-checked="false"] span{transform:translateX(calc((clamp(43px,4.8vw,49px) - 6px - (clamp(25px,2.8vw,29px) - 6px)) * -1))}.custom-field{align-items:center;border:1px dashed color-mix(in srgb,#0aafd1,transparent 35%);border-radius:clamp(14px,1.8vw,18px);color:#0aafd1;display:flex;gap:.65rem;margin-top:clamp(.7rem,1.3vw,1rem);padding:clamp(.6rem,1vw,.8rem)}.custom-field>span:last-child{display:flex;flex-direction:column}.custom-field strong{font-size:clamp(.66rem,1.15vw,.88rem)}.custom-field small{color:var(--demo-muted,#8e8e93);font-size:clamp(.47rem,.75vw,.6rem)}.custom-plus{font-size:1.25rem}.flow-arrow{color:var(--accent);font-size:1.5rem}.entry-panel{justify-content:flex-start}.preview-row{max-height:70px;opacity:1;overflow:hidden;transition:border-width .35s ease,max-height .35s ease,min-height .35s ease,opacity .25s ease,padding .35s ease,transform .35s ease}.preview-row span{font-size:clamp(.68rem,1.2vw,.94rem)}.preview-row strong{background:var(--demo-pill,#343438);border-radius:999px;color:var(--demo-text,#f5f5f7);font-size:clamp(.67rem,1.15vw,.9rem);font-weight:400;padding:.3rem .55rem}.preview-row[data-collapsed]{border-width:0;max-height:0;min-height:0;opacity:0;padding-bottom:0;padding-top:0;transform:translateX(-8px)}.preview-row[hidden]{display:none}.noscript-note{color:var(--muted);font-size:.8rem;grid-column:1/-1}
  @media(prefers-color-scheme:light){.app-panel{--demo-bg:#f2f2f7;--demo-card:#fff;--demo-text:#1c1c1e;--demo-muted:#6e6e73;--demo-line:#d1d1d6;--demo-pill:#e5e5ea;--demo-switch-off:#aeaeb2}}
  @media(max-width:950px){.custom-demo{grid-template-columns:1fr}.demo-copy{text-align:center}.demo-status{margin-inline:auto;max-width:500px}.demo-stage{margin-inline:auto;max-width:700px}}
  @media(max-width:580px){.custom-demo{padding-inline:0;width:min(calc(100% - 28px),var(--max))}.demo-stage{grid-template-columns:1fr}.app-panel{margin-inline:auto;max-width:320px}.flow-arrow{font-size:1.2rem;text-align:center;transform:rotate(90deg)}}
  @media(prefers-reduced-motion:reduce){.switch,.switch span,.preview-row{transition:none}}
</style>
