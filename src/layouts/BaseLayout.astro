---
import '../styles/global.css';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = site.name,
  description = site.description,
  image = '/social-preview.svg',
  noindex = false,
} = Astro.props;
const pageTitle = title === site.name ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.canonicalUrl);
const socialImage = new URL(image.replace(/^\//, ''), `${site.canonicalUrl}/`);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main-content">Skip to content</a>
    <header class="site-header">
      <nav class="nav container" aria-label="Main navigation">
        <a class="brand" href={withBase('/')} aria-label={`${site.name} home`}>
          <span><img src={withBase('/LogMyFlight_Icon_Rev1-iOS-Default-1024x1024@1x.png')} class="brand-mark" aria-hidden="true" /></span>
          {site.name}
        </a>
        <div class="links">
          <a href={withBase('/privacy/')}>Privacy</a>
        </div>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer>
      <div class="container footer-grid">
        <div><strong>{site.name}</strong><p>Privacy policy for LogMyFlight.</p></div>
        <nav aria-label="Footer navigation">
          <a href={withBase('/privacy/')}>Privacy</a>
        </nav>
        <p class="copyright">© {new Date().getFullYear()} {site.developerName}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip { background: var(--text); color: var(--bg); left: 1rem; padding: .6rem 1rem; position: fixed; top: -5rem; z-index: 100; }
  .skip:focus { top: 1rem; }
  .site-header { backdrop-filter: saturate(180%) blur(18px); background: var(--nav); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
  .nav { align-items: center; display: flex; height: 58px; justify-content: space-between; }
  .brand { align-items: center; color: var(--text); display: flex; font-size: .98rem; font-weight: 700; gap: .55rem; text-decoration: none; }
  .brand-mark { align-items: center; background: var(--accent); border-radius: 9px; color: white; display: inline-flex; height: 30px; justify-content: center; width: 30px; }
  .links { align-items: center; display: flex; gap: 1.5rem; }
  .links a { color: var(--text); font-size: .82rem; text-decoration: none; }
  .links a:hover { color: var(--accent); }
  footer { border-top: 1px solid var(--line); padding: 3rem 0; }
  .footer-grid { align-items: start; display: grid; gap: 1.5rem; grid-template-columns: 1fr auto; }
  footer p { color: var(--muted); font-size: .82rem; margin-top: .25rem; }
  footer nav { display: flex; gap: 1.2rem; }
  footer nav a { color: var(--muted); font-size: .82rem; }
  .copyright { grid-column: 1 / -1; }
  @media (max-width: 650px) { .footer-grid { grid-template-columns: 1fr; } .copyright { grid-column: auto; } }
</style>
