---
import BaseLayout from '../layouts/BaseLayout.astro';
const supportUrl = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}support/`;
const privacyUrl = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}privacy/`;
---
<BaseLayout title="LogMyFlight Support" description="Support and privacy policy information for LogMyFlight.">
  <section class="privacy-home container">
    <div>
      <p class="eyebrow">LogMyFlight</p>
      <h1>Support</h1>
      <p class="lede">Support contact and privacy policy information for LogMyFlight's App Store submission.</p>
      <div class="actions">
        <a class="button" href={supportUrl}>Get Support</a>
        <a class="button secondary" href={privacyUrl}>Privacy Policy</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy-home {
    align-items: center;
    display: grid;
    min-height: calc(100vh - 58px);
    padding-block: 72px;
  }

  .privacy-home > div {
    max-width: 760px;
  }

  .privacy-home h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    margin: .7rem 0 1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
    margin-top: 2rem;
  }
</style>
