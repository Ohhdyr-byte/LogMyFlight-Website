---
import BaseLayout from '../layouts/BaseLayout.astro';
const privacyUrl = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}privacy/`;
---
<BaseLayout title="LogMyFlight Privacy Policy" description="Privacy policy for LogMyFlight.">
  <section class="privacy-home container">
    <div>
      <p class="eyebrow">LogMyFlight</p>
      <h1>Privacy Policy</h1>
      <p class="lede">This site currently provides the privacy policy needed for LogMyFlight's App Store submission.</p>
      <a class="button" href={privacyUrl}>Read the Privacy Policy</a>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy-home {
    align-items: center;
    display: grid;
    min-height: calc(100vh - 58px);
    padding-block: 72px;
  }

  .privacy-home > div {
    max-width: 760px;
  }

  .privacy-home h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    margin: .7rem 0 1rem;
  }

  .privacy-home .button {
    margin-top: 2rem;
  }
</style>
